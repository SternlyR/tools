# Bose Soundlink Gen 1 MAC address
# Find it by running: bluetoothctl scan on
# then look for your Bose device and copy its MAC address here
BOSE_MAC_ADDRESS=XX:XX:XX:XX:XX:XX

# Audio stream URL
# freaksonly.fm direct stream
STREAM_URL=https://streaming.live365.com/a77923

# Audio sink name — leave as "auto" to use the Bose once connected,
# or set to the exact PulseAudio sink name (find with: pactl list sinks short)
AUDIO_SINK=auto

# Seconds to wait after BT connect before starting stream (let audio sink initialize)
CONNECT_DELAY=3
